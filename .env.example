# ============================================
# SafePath — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================

# ---- Database ----
# Leave DATABASE_URL unset to use a local SQLite file (backend/safepath.db) and
# skip Docker entirely. Set it to run against the PostgreSQL service instead.
# DATABASE_URL=postgresql://safepath_user:safepath_pass@localhost:5432/safepath_db

# ---- Firebase Admin SDK (Backend) ----
# Path to your Firebase service account JSON file. If the file is absent the
# backend runs in open demo mode: requests resolve to a single shared demo user
# instead of being rejected.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ---- Firebase Client SDK (Frontend) ----
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ---- Google Maps (Frontend) ----
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ---- SMS alerts (Twilio) ----
# Without all three of these, SOS and test alerts are recorded but NO message
# is sent, and the app says so plainly instead of claiming delivery.
# Get these from https://console.twilio.com after signing up.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Prepended to contact numbers saved without a country code.
DEFAULT_COUNTRY_CODE=+91
# Base URL used for live-tracking links inside outgoing messages.
PUBLIC_APP_URL=http://localhost:5173
# Text every contact on SOS (true) or only the primary one (false).
SOS_NOTIFY_ALL_CONTACTS=true

# ---- Backend ----
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- Frontend ----
VITE_API_URL=http://localhost:8000/api
